#!/bin/bash
# Runs on the build host after everything else has touched the image tree.
# Keeps a pristine copy of /etc in /usr so the installer (and later a
# factory reset) can lay down a fresh /etc on a new root partition, and
# turns every system user into a sysusers.d entry so a /usr update that adds
# a user also creates it on machines whose /etc predates it.
set -euo pipefail
R="$BUILDROOT"

# mkosi 25.3 copies Debian's MokManager as EFI/BOOT/mmx64.efi.signed, but
# shim looks for mmx64.efi next to itself. Without it shim can't start
# MokManager to enroll our key.
B=$R/efi/EFI/BOOT
if [[ -f $B/mmx64.efi.signed ]]; then
    mv "$B/mmx64.efi.signed" "$B/mmx64.efi"
fi
[[ -f $B/mmx64.efi ]] || { echo "mkosi.finalize: MokManager missing from $B" >&2; exit 1; }

echo uninitialized >"$R/etc/machine-id"
rm -f "$R/etc/.updated" "$R/var/.updated"

python3 - "$R" <<'PY'
import sys
from pathlib import Path
r = Path(sys.argv[1])
lines = ["# Generated at image build from /etc/passwd and /etc/group.\n"]
for l in (r / "etc/group").read_text().splitlines():
    name, _, gid, _ = l.split(":", 3)
    if name != "root" and int(gid) < 1000:
        lines.append(f"g {name} {gid}\n")
for l in (r / "etc/passwd").read_text().splitlines():
    name, _, uid, gid, gecos, home, shell = l.split(":")
    if name != "root" and int(uid) < 1000:
        gecos = gecos.split(",")[0].replace('"', "") or "-"
        lines.append(f'u {name} {uid}:{gid} "{gecos}" {home} {shell}\n')
(r / "usr/lib/sysusers.d/00-image.conf").write_text("".join(lines))

# Debian's alternatives are symlinks in /etc/alternatives that /usr points
# into (libblas.so.3 -> /etc/alternatives/... -> blas/libblas.so.3). /etc is
# only written at install, so a package a /usr update adds would find its
# alternatives missing: ffmpeg (through libsphinxbase -> libblas) failed to
# start with exit 127 on players updated to 0.3.4. tmpfiles creates any that
# are missing at boot and leaves existing ones alone.
alts = r / "etc/alternatives"
lines = ["# Generated at image build from /etc/alternatives (see mkosi.finalize).\n"]
for a in sorted(alts.iterdir()):
    if a.is_symlink():
        lines.append(f"L /etc/alternatives/{a.name} - - - - {a.readlink()}\n")
(r / "usr/lib/tmpfiles.d/00-image-alternatives.conf").write_text("".join(lines))
PY

rm -rf "$R/usr/share/factory/etc"
mkdir -p "$R/usr/share/factory"
cp -a "$R/etc" "$R/usr/share/factory/etc"
