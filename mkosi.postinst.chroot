#!/bin/bash
# Runs inside the image after packages and mkosi.extra are installed.
set -euo pipefail

# Files from mkosi.extra keep the checkout's modes; make them sane.
chmod 0755 /usr/lib/signage /usr/lib/signage/*
find /usr/lib/systemd/system -name 'signage-*' -exec chmod 0644 {} +
chmod 0755 /usr/lib/systemd/system/emergency.service.d
chmod 0644 /usr/lib/sysusers.d/signage.conf /usr/lib/tmpfiles.d/signage.conf /usr/lib/sysupdate.d/*.transfer
chmod -R a+rX /usr/share/signage /usr/lib/firefox-esr/distribution
# The host page reads the kiosk's status.json through signage-web.
ln -sfn /run/signage-kiosk /usr/share/signage/status
# Debian only ships /usr/lib/systemd/systemd-sysupdate; put it on PATH.
ln -sf ../lib/systemd/systemd-sysupdate /usr/bin/systemd-sysupdate
# Diagnostics for the dashboard's web terminal.
ln -sf ../lib/signage/signage-gfx /usr/bin/signage-gfx
ln -sf ../lib/signage/signage-profile /usr/bin/signage-profile
chmod 0644 /etc/pam.d/cage /etc/chrony/conf.d/signage.conf
# Dashboard agent: lives with the dashboard in dashboard/agent/ so both sides
# change together.
install -D -m 0755 "$SRCDIR/dashboard/agent/signage-agent" /usr/lib/signage/signage-agent
install -D -m 0644 "$SRCDIR/dashboard/agent/signage-agent.service" /usr/lib/systemd/system/signage-agent.service
install -D -m 0755 "$SRCDIR/dashboard/agent/signage-stream" /usr/lib/signage/signage-stream

# Drop modules, firmware, translations and Firefox bits players never use
# (see the script for what and why).
python3 "$SRCDIR/scripts/trim-image.py" /

systemd-sysusers
systemctl enable signage-config.service signage-install.service signage-player.service signage-web.service signage-agent.service signage-banner.service
systemctl enable NetworkManager.service chrony.service fstrim.timer
systemctl set-default multi-user.target
# mkosi runs "systemctl preset-all", and Debian's 90-systemd.preset has no
# "disable *", so every unit with an [Install] section gets enabled,
# including systemd-pcrlock's policy units. Those need a pcrlock policy we
# don't use (TPM-sealed secrets will use signed PCR policies instead) and
# fail on machines with a TPM.
for u in /usr/lib/systemd/system/systemd-pcrlock*.service /usr/lib/systemd/system/systemd-pcrlock*.socket; do
    [[ -e $u ]] && systemctl mask "${u##*/}"
done
# The kiosk owns tty1; the installer prints there too.
systemctl mask getty@tty1.service
# NetworkManager runs the network. preset-all also enables systemd-networkd,
# and its wait-online then waits its full 2 minutes for links it doesn't
# manage, which holds network-online.target (and anything after it) until
# 2 min after boot. Masked in /usr, not just /etc: an installed player keeps
# its own /etc across /usr updates, with the old enable symlinks in it.
for u in systemd-networkd.service systemd-networkd.socket systemd-networkd-varlink.socket \
         systemd-networkd-resolve-hook.socket systemd-networkd-wait-online.service \
         systemd-networkd-wait-online@.service systemd-networkd-persistent-storage.service \
         systemd-network-generator.service; do
    f=/usr/lib/systemd/system/$u
    [[ -e $f || -L $f ]] || continue
    ln -sfn /dev/null "$f"
    find /etc/systemd/system -lname "*/$u" -delete
done

if [[ " ${PROFILES:-} " == *" debug "* ]]; then
    systemctl enable serial-getty@ttyS0.service getty@tty2.service
fi
