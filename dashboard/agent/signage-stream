class UInput:
    """One virtual input device. Created when the viewer may control the
    sign and destroyed when the stream ends (so cage hides its pointer)."""

    def __init__(self, name, keys=(), rels=(), absolute=False):
        self.fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        if keys:
            fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_KEY)
            for k in keys:
                fcntl.ioctl(self.fd, UI_SET_KEYBIT, k)
        if rels:
            fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_REL)
            for r in rels:
                fcntl.ioctl(self.fd, UI_SET_RELBIT, r)
        if absolute:
            # A tablet-like absolute pointer (like QEMU's usb-tablet):
            # libinput maps 0..ABS_MAX across the whole output layout.
            fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_ABS)
            for axis in (0, 1):
                fcntl.ioctl(self.fd, UI_SET_ABSBIT, axis)
                fcntl.ioctl(self.fd, UI_ABS_SETUP, struct.pack("HxxiiiiII", axis, 0, 0, ABS_MAX, 0, 0, 0))
        setup = struct.pack("HHHH80sI", 0x06, 0x1d6b, 0x0104, 1, name.encode()[:79], 0)
        fcntl.ioctl(self.fd, UI_DEV_SETUP, setup)
        fcntl.ioctl(self.fd, UI_DEV_CREATE)

    def emit(self, events):
        buf = b"".join(struct.pack("llHHi", 0, 0, t, c, v) for t, c, v in events)
        os.write(self.fd, buf + struct.pack("llHHi", 0, 0, EV_SYN, 0, 0))

    def close(self):
        try:
            fcntl.ioctl(self.fd, UI_DEV_DESTROY)
        except OSError:
            pass
        os.close(self.fd)


class Input:
    """Turns the viewer's events into uinput events. Coordinates arrive as
    0..1 across the streamed output, upright as people see it, and are mapped
    into the whole layout (the absolute pointer covers every output)."""

    def __init__(self, output, outputs):
        self.pointer = UInput("signage remote pointer", keys=list(BTN.values()),
                              rels=[REL_WHEEL, REL_HWHEEL, REL_WHEEL_HI_RES, REL_HWHEEL_HI_RES], absolute=True)
        self.keyboard = UInput("signage remote keyboard", keys=sorted(set(KEYS.values())))
        self.out = output
        self.x0 = min(o["x"] for o in outputs)
        self.y0 = min(o["y"] for o in outputs)
        self.w = max(o["x"] + o["lwidth"] for o in outputs) - self.x0
        self.h = max(o["y"] + o["lheight"] for o in outputs) - self.y0
        self.down = set()

    def handle(self, m):
        t = m.get("t")
        if t == "m":
            x = self.out["x"] + min(1, max(0, float(m["x"]))) * self.out["lwidth"]
            y = self.out["y"] + min(1, max(0, float(m["y"]))) * self.out["lheight"]
            self.pointer.emit([(EV_ABS, 0, round((x - self.x0) / max(1, self.w) * ABS_MAX)),
                               (EV_ABS, 1, round((y - self.y0) / max(1, self.h) * ABS_MAX))])
        elif t == "b" and int(m.get("b", -1)) in BTN:
            code = BTN[int(m["b"])]
            self.press(self.pointer, code, bool(m.get("d")))
        elif t == "w":
            # Browser deltas in pixels (deltaMode 0); about 120 px a notch.
            ev = []
            for axis, hi, sign, key in ((REL_WHEEL, REL_WHEEL_HI_RES, -1, "dy"), (REL_HWHEEL, REL_HWHEEL_HI_RES, 1, "dx")):
                v = round(sign * float(m.get(key, 0)))
                if v:
                    ev.append((EV_REL, hi, max(-1200, min(1200, v))))
                    notches = int(v / 120)
                    if notches:
                        ev.append((EV_REL, axis, notches))
            if ev:
                self.pointer.emit(ev)
        elif t == "k" and m.get("c") in KEYS:
            self.press(self.keyboard, KEYS[m["c"]], bool(m.get("d")))
        elif t == "release":
            self.release_all()

    def press(self, dev, code, down):
        if down == ((dev, code) in self.down):
            return
        (self.down.add if down else self.down.discard)((dev, code))
        dev.emit([(EV_KEY, code, 1 if down else 0)])

    def release_all(self):
        for dev, code in list(self.down):
            self.press(dev, code, False)

    def close(self):
        try:
            self.release_all()
        except OSError:
            pass
        self.pointer.close()
        self.keyboard.close()


class EchoInput:
    """Test mode: reports input events instead of injecting them."""

    def handle(self, m):
        emit({"t": "echo", "m": m})

    def close(self):
        pass


# ------------------------------------------------------------------ WebRTC

def ice_config(webrtc, servers):
    for s in servers or []:
        urls = s.get("urls")
        for url in [urls] if isinstance(urls, str) else (urls or []):
            scheme, _, rest = url.partition(":")
            rest, _, query = rest.partition("?")
            if scheme == "stun" and not webrtc.get_property("stun-server"):
                webrtc.set_property("stun-server", f"stun://{rest}")
            elif scheme in ("turn", "turns"):
                user = urllib.parse.quote(str(s.get("username", "")), safe="")
                cred = urllib.parse.quote(str(s.get("credential", "")), safe="")
                uri = f"{scheme}://{user}:{cred}@{rest}" + (f"?{query}" if query else "")
                webrtc.emit("add-turn-server", uri)


class Stream:
    def __init__(self, cfg):
        self.cfg = cfg
        self.loop = GLib.MainLoop()
        self.ffmpeg = None
        self.input = None
        self.pipe = None
        self.offered = False
        self.negotiating = False
        self.channel = None
        self.answered = False
        self.reason = "stopped"

    # -- setup

    def pick_source(self):
        if os.environ.get("SIGNAGE_STREAM_SOURCE") == "test":
            w, h = fit(1920, 1080, self.cfg.get("quality") or "720")
            out = {"name": "TEST-1", "width": w, "height": h, "transform": "normal", "x": 0, "y": 0,
                   "lwidth": w, "lheight": h}
            return {"test": True}, out, [out]
        outputs = wlr_outputs()
        want = self.cfg.get("output") or ""
        out = next((o for o in outputs if o["name"] == want), None) if want else outputs[0]
        if not out:
            raise RuntimeError(f"output {want} isn't on")
        crtcs = drm_crtcs()
        if out["name"] not in crtcs:
            raise RuntimeError(f"couldn't find {out['name']}'s CRTC (lit connectors: {', '.join(crtcs) or 'none'})")
        card, crtc = crtcs[out["name"]]
        return {"card": card, "crtc": crtc}, out, outputs

    def start_ffmpeg(self, source, w, h, bitrate):
        """Hardware encode if the GPU does it, otherwise x264 at no more than 720p."""
        last = ""
        for hw in ([False] if source.get("test") else [True, False]):
            ew, eh = (w, h) if hw or source.get("test") else fit(w, h, "720")
            cmd = ffmpeg_cmd(source, ew, eh, bitrate, hw)
            log(" ".join(cmd))
            p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            # Wait for the first bytes of video: a failure (no VAAPI, kmsgrab
            # refused) exits within a second or two.
            r, _, _ = select.select([p.stdout], [], [], 8)
            if r and p.poll() is None:
                threading.Thread(target=self.ffmpeg_log, args=(p,), daemon=True).start()
                return p, ew, eh, "h264_vaapi" if hw else "libx264"
            p.kill()
            err = p.stderr.read().decode(errors="replace").strip()[-400:]
            p.wait()
            log(f"ffmpeg ({'VAAPI' if hw else 'x264'}) failed: {err}")
            last = err
        raise RuntimeError(f"couldn't capture the screen: {last or 'ffmpeg exited'}")

    def ffmpeg_log(self, p):
        for line in p.stderr:
            log("ffmpeg: " + line.decode(errors="replace").rstrip())
        code = p.wait()
        if self.ffmpeg is p:
            GLib.idle_add(self.stop, f"capture ended (ffmpeg exited with {code})")

    def build(self):
        source, out, outputs = self.pick_source()
        w, h = fit(out["width"], out["height"], self.cfg.get("quality") or "native")
        bitrate = int(self.cfg.get("bitrate") or 0) or default_bitrate(w, h)
        self.ffmpeg, w, h, encoder = self.start_ffmpeg(source, w, h, bitrate)

        self.pipe = Gst.parse_launch(
            f"fdsrc name=src fd={self.ffmpeg.stdout.fileno()} do-timestamp=true blocksize=65536 "
            "! video/x-h264,stream-format=byte-stream ! queue max-size-buffers=0 max-size-time=0 max-size-bytes=0 "
            "! h264parse ! video/x-h264,stream-format=byte-stream,alignment=au "
            "! rtph264pay config-interval=-1 aggregate-mode=zero-latency mtu=1200 pt=96 "
            # Closed until the peer connection is up: video pushed into
            # webrtcbin while it negotiates could stall the stream for good.
            "! valve name=gate drop=true drop-mode=forward-sticky-events "
            "! application/x-rtp,media=video,encoding-name=H264,payload=96,clock-rate=90000 "
            # No BUNDLE: GStreamer 1.24's webrtcbin sometimes aborts on
            # an assertion (_connect_rtpfunnel) when applying a bundled
            # answer. Unbundled, video and the input channel each get their
            # own ICE transport, which browsers accept.
            "! webrtcbin name=webrtc bundle-policy=none latency=0")
        self.webrtc = self.pipe.get_by_name("webrtc")
        ice_config(self.webrtc, self.cfg.get("ice_servers"))
        self.webrtc.connect("on-negotiation-needed", self.on_negotiation_needed)
        self.webrtc.connect("notify::ice-gathering-state", self.on_gathering)
        self.webrtc.connect("notify::ice-connection-state", self.on_ice_state)
        self.webrtc.connect("notify::connection-state", self.on_conn_state)
        bus = self.pipe.get_bus()
        bus.add_signal_watch()
        bus.connect("message::error", self.on_error)

        if self.cfg.get("control") and source.get("test"):
            self.input = EchoInput()
        elif self.cfg.get("control"):
            try:
                self.input = Input(out, outputs)
            except OSError as e:
                emit({"t": "warning", "message": f"remote control unavailable: {e}"})
        self.info = {"t": "info", "output": out["name"], "outputs": [o["name"] for o in outputs],
                     "transform": out["transform"], "width": w, "height": h,
                     "mode": f"{out['width']}x{out['height']}", "fps": FPS, "bitrate": bitrate,
                     "encoder": encoder, "control": bool(self.input)}
        emit(self.info)
        self.pipe.set_state(Gst.State.PLAYING)
        # The browser sends mouse and keyboard events on this channel.
        self.channel = self.webrtc.emit("create-data-channel", "input", None)
        if self.channel:
            self.channel.connect("on-message-string", self.on_input)

    # -- negotiation (non-trickle: one offer, one answer, candidates inside;
    # the relay can reorder messages, so fewer of them is simpler)

    def on_negotiation_needed(self, webrtc):
        if self.negotiating:
            return
        self.negotiating = True
        promise = Gst.Promise.new_with_change_func(self.on_offer_created, webrtc)
        webrtc.emit("create-offer", None, promise)

    def on_offer_created(self, promise, webrtc):
        promise.wait()
        reply = promise.get_reply()
        offer = reply.get_value("offer") if reply and reply.has_field("offer") else None
        if not offer:
            err = reply.get_value("error") if reply and reply.has_field("error") else None
            GLib.idle_add(self.stop, f"couldn't create the offer: {err.message if err else reply}")
            return
        webrtc.emit("set-local-description", offer, Gst.Promise.new())
        GLib.timeout_add_seconds(GATHER_TIMEOUT, self.send_offer)

    def on_gathering(self, webrtc, _pspec):
        if webrtc.get_property("ice-gathering-state") == GstWebRTC.WebRTCICEGatheringState.COMPLETE:
            GLib.idle_add(self.send_offer)

    def send_offer(self):
        if self.offered:
            return False
        desc = self.webrtc.get_property("local-description")
        if not desc:
            return False
        self.offered = True
        emit({"t": "offer", "sdp": desc.sdp.as_text()})
        GLib.timeout_add_seconds(ANSWER_TIMEOUT, self.answer_timeout)
        return False

    def answer_timeout(self):
        if not self.answered:
            self.stop("the viewer didn't answer")
        return False

    def on_answer(self, sdp):
        ok, msg = GstSdp.SDPMessage.new_from_text(sdp)
        if ok != GstSdp.SDPResult.OK:
            raise ValueError("bad SDP answer")
        self.answered = True
        answer = GstWebRTC.WebRTCSessionDescription.new(GstWebRTC.WebRTCSDPType.ANSWER, msg)
        self.webrtc.emit("set-remote-description", answer, Gst.Promise.new())

    def on_ice_state(self, webrtc, _pspec):
        state = webrtc.get_property("ice-connection-state")
        log(f"ICE {state.value_nick}")
        if state == GstWebRTC.WebRTCICEConnectionState.FAILED:
            GLib.idle_add(self.stop, "no network path to the viewer (ICE failed; a TURN server may be needed)")

    def on_conn_state(self, webrtc, _pspec):
        state = webrtc.get_property("connection-state")
        log(f"connection {state.value_nick}")
        if state == GstWebRTC.WebRTCPeerConnectionState.CONNECTED:
            self.pipe.get_by_name("gate").set_property("drop", False)
            emit({"t": "connected"})
        elif state in (GstWebRTC.WebRTCPeerConnectionState.FAILED, GstWebRTC.WebRTCPeerConnectionState.CLOSED):
            GLib.idle_add(self.stop, f"connection {state.value_nick}")

    def on_input(self, _ch, text):
        if not self.input:
            return
        try:
            for m in json.loads(text) if text.startswith("[") else [json.loads(text)]:
                self.input.handle(m)
        except (ValueError, KeyError, TypeError, OSError) as e:
            log(f"bad input event {text[:80]!r}: {e}")

    def on_error(self, _bus, msg):
        err, dbg = msg.parse_error()
        log(f"GStreamer: {err.message} ({dbg})")
        if msg.src and msg.src.get_name().startswith("sctp"):
            # The data channel's association drops when the browser closes
            # the connection (often just before its "stop" arrives).
            self.stop("closed by the viewer")
        else:
            self.stop(f"GStreamer: {err.message}")

    # -- control from the agent

    def read_stdin(self):
        for line in sys.stdin:
            try:
                m = json.loads(line)
            except ValueError:
                continue
            if m.get("t") == "answer":
                GLib.idle_add(self._answer, m.get("sdp", ""))
            elif m.get("t") == "stop":
                GLib.idle_add(self.stop, m.get("reason") or "closed by the viewer")
                return
        GLib.idle_add(self.stop, "agent went away")

    def _answer(self, sdp):
        try:
            self.on_answer(sdp)
        except Exception as e:
            self.stop(f"couldn't use the viewer's answer: {e}")
        return False

    def stop(self, reason="stopped"):
        if not self.loop.is_running():
            return False
        self.reason = reason
        self.loop.quit()
        return False

    def run(self):
        try:
            self.build()
        except Exception as e:
            emit({"t": "error", "message": str(e)})
            self.cleanup()
            return 1
        threading.Thread(target=self.read_stdin, daemon=True).start()
        for sig in (signal.SIGTERM, signal.SIGINT):
            GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, self.stop, "terminated")
        self.loop.run()
        emit({"t": "ended", "reason": self.reason})
        self.cleanup()
        return 0

    def cleanup(self):
        if self.input:
            self.input.close()
            self.input = None
        p, self.ffmpeg = self.ffmpeg, None
        if p and p.poll() is None:
            p.terminate()
            try:
                p.wait(3)
            except subprocess.TimeoutExpired:
                p.kill()
        if self.pipe:
            self.pipe.set_state(Gst.State.NULL)


def main():
    cfg = json.loads(sys.argv[1]) if len(sys.argv) > 1 else {}
    if not shutil.which("ffmpeg"):
        emit({"t": "error", "message": "ffmpeg isn't installed (this OS image predates live view)"})
        return 1
    Gst.init(None)
    return Stream(cfg).run()


if __name__ == "__main__":
    sys.exit(main())
