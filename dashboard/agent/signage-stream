FPS = 30
GATHER_TIMEOUT = 6      # seconds to wait for ICE candidates before sending the offer
ANSWER_TIMEOUT = 60     # seconds to wait for the browser's answer
QUALITY = {"native": None, "1080": (1920, 1080), "720": (1280, 720)}


def log(msg):
    print(f"signage-stream: {msg}", file=sys.stderr, flush=True)


out_lock = threading.Lock()


def emit(msg):
    with out_lock:
        sys.stdout.write(json.dumps(msg) + "\n")
        sys.stdout.flush()


# ------------------------------------------------------------------ outputs

def wlr_outputs():
    """Enabled outputs from wlr-randr: name, mode size, transform, and the
    logical rectangle in the layout (what the pointer moves over)."""
    r = subprocess.run(["wlr-randr", "--json"], capture_output=True, text=True, timeout=10)
    if r.returncode != 0:
        raise RuntimeError((r.stderr or "wlr-randr failed").strip())
    outs = []
    for o in json.loads(r.stdout):
        if not o.get("enabled"):
            continue
        mode = next((m for m in o.get("modes", []) if m.get("current")), None)
        if not mode:
            continue
        t = str(o.get("transform") or "normal")
        s = o.get("scale") or 1
        w, h = mode["width"], mode["height"]
        lw, lh = (h, w) if t.endswith("90") or t.endswith("270") else (w, h)
        pos = o.get("position") or {}
        outs.append({"name": o["name"], "width": w, "height": h, "transform": t,
                     "x": pos.get("x", 0), "y": pos.get("y", 0),
                     "lwidth": round(lw / s), "lheight": round(lh / s)})
    if not outs:
        raise RuntimeError("no enabled outputs")
    return sorted(outs, key=lambda o: (o["x"], o["y"]))


class DrmModeRes(ctypes.Structure):
    _fields_ = [("count_fbs", ctypes.c_int), ("fbs", ctypes.POINTER(ctypes.c_uint32)),
                ("count_crtcs", ctypes.c_int), ("crtcs", ctypes.POINTER(ctypes.c_uint32)),
                ("count_connectors", ctypes.c_int), ("connectors", ctypes.POINTER(ctypes.c_uint32)),
                ("count_encoders", ctypes.c_int), ("encoders", ctypes.POINTER(ctypes.c_uint32)),
                ("min_width", ctypes.c_uint32), ("max_width", ctypes.c_uint32),
                ("min_height", ctypes.c_uint32), ("max_height", ctypes.c_uint32)]


class DrmModeConnector(ctypes.Structure):
    _fields_ = [("connector_id", ctypes.c_uint32), ("encoder_id", ctypes.c_uint32),
                ("connector_type", ctypes.c_uint32), ("connector_type_id", ctypes.c_uint32)]
    # (the rest of the struct isn't read; libdrm allocates and frees it)


class DrmModeEncoder(ctypes.Structure):
    _fields_ = [("encoder_id", ctypes.c_uint32), ("encoder_type", ctypes.c_uint32),
                ("crtc_id", ctypes.c_uint32), ("possible_crtcs", ctypes.c_uint32),
                ("possible_clones", ctypes.c_uint32)]


def drm_crtcs():
    """{output name: (card path, CRTC id)} for every lit connector, named the
    way wlroots names outputs (DP-1, HDMI-A-1, ...)."""
    lib = ctypes.CDLL(ctypes.util.find_library("drm") or "libdrm.so.2")
    lib.drmModeGetResources.restype = ctypes.POINTER(DrmModeRes)
    lib.drmModeGetConnector.restype = ctypes.POINTER(DrmModeConnector)
    lib.drmModeGetEncoder.restype = ctypes.POINTER(DrmModeEncoder)
    lib.drmModeGetConnectorTypeName.restype = ctypes.c_char_p
    found = {}
    for card in sorted(Path("/dev/dri").glob("card*")):
        try:
            fd = os.open(card, os.O_RDWR | os.O_CLOEXEC)
        except OSError:
            continue
        try:
            res = lib.drmModeGetResources(fd)
            if not res:
                continue
            for i in range(res.contents.count_connectors):
                con = lib.drmModeGetConnector(fd, res.contents.connectors[i])
                if not con:
                    continue
                c = con.contents
                tname = lib.drmModeGetConnectorTypeName(c.connector_type)
                name = f"{tname.decode() if tname else 'Unknown'}-{c.connector_type_id}"
                if c.encoder_id:
                    enc = lib.drmModeGetEncoder(fd, c.encoder_id)
                    if enc:
                        if enc.contents.crtc_id:
                            found[name] = (str(card), enc.contents.crtc_id)
                        lib.drmModeFreeEncoder(enc)
                lib.drmModeFreeConnector(con)
            lib.drmModeFreeResources(res)
        finally:
            os.close(fd)
    return found


def even(n):
    return max(2, int(n) // 2 * 2)


def fit(w, h, quality):
    """Encoded size: the mode size, scaled down to fit the quality's box
    (compared in the screen's own orientation)."""
    box = QUALITY.get(quality)
    if not box:
        return even(w), even(h)
    bw, bh = box if w >= h else box[::-1]
    s = min(1.0, bw / w, bh / h)
    return even(w * s), even(h * s)


def default_bitrate(w, h):
    # About 0.1 bit per pixel at 30 fps: 6 Mb/s at 1080p, capped for 4K.
    return int(min(16e6, max(1.5e6, w * h * FPS * 0.1)))


# ------------------------------------------------------------------ ffmpeg

def ffmpeg_cmd(source, w, h, bitrate, hw):
    common = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin"]
    gop = ["-g", str(FPS * 2), "-bf", "0"]
    out = ["-f", "h264", "-flush_packets", "1", "pipe:1"]
    if source.get("test"):
        return common + ["-re", "-f", "lavfi", "-i", f"testsrc2=size={w}x{h}:rate={FPS}",
                         "-vf", "format=yuv420p", "-c:v", "libx264", "-preset", "ultrafast",
                         "-tune", "zerolatency", "-profile:v", "baseline",
                         "-b:v", str(bitrate), "-maxrate", str(bitrate), "-bufsize", str(bitrate // 2)] + gop + out
    grab = ["-device", source["card"], "-f", "kmsgrab", "-crtc_id", str(source["crtc"]),
            "-framerate", str(FPS), "-i", "-"]
    if hw:
        # Zero copy: the scanout buffer goes to the GPU's scaler and encoder
        # without passing through system memory.
        return common + grab + [
            "-vf", f"hwmap=derive_device=vaapi,scale_vaapi=w={w}:h={h}:format=nv12",
            "-c:v", "h264_vaapi", "-profile:v", "constrained_baseline", "-rc_mode", "CBR",
            "-b:v", str(bitrate), "-maxrate", str(bitrate)] + gop + out
    return common + grab + [
        "-vf", f"hwdownload,format=bgr0,scale={w}:{h},format=yuv420p",
        "-c:v", "libx264", "-preset", "ultrafast", "-tune", "zerolatency", "-profile:v", "baseline",
        "-b:v", str(bitrate), "-maxrate", str(bitrate), "-bufsize", str(bitrate // 2)] + gop + out


