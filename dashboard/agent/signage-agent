# ------------------------------------------------------------------ performance samples
# Every 10 s: CPU, memory, temperatures and GPU load from /proc and /sys, plus
# the player's frame timings from /run/signage/perf.json (written every ~5 s,
# so the sampler reads it more often and merges the windows it saw). Kept for
# 2 h and sent with check-ins until the dashboard acknowledges them.

PROC = Path(os.environ.get("SIGNAGE_PROC", "/proc"))
SYS = Path(os.environ.get("SIGNAGE_SYS", "/sys"))
PERF_EVERY = 10
PERF_KEEP = 720
PERF_BATCH = 120


def _read(path, default=""):
    try:
        return Path(path).read_text()
    except OSError:
        return default


def cpu_times():
    """{"cpu": (busy, total), "cpu0": ...} from /proc/stat."""
    out = {}
    for line in _read(PROC / "stat").splitlines():
        if not line.startswith("cpu"):
            break
        f = line.split()
        v = [int(x) for x in f[1:9]]
        idle = v[3] + v[4]
        out[f[0]] = (sum(v) - idle, sum(v))
    return out


def meminfo():
    m = {}
    for line in _read(PROC / "meminfo").splitlines():
        k, _, rest = line.partition(":")
        try:
            m[k] = int(rest.split()[0])
        except (IndexError, ValueError):
            pass
    return m


def firefox_rss_mb():
    page = os.sysconf("SC_PAGE_SIZE") if hasattr(os, "sysconf") else 4096
    total = 0
    for d in PROC.iterdir() if PROC.is_dir() else []:
        if not d.name.isdigit():
            continue
        cmd = _read(d / "cmdline").split("\0", 1)[0]
        if "firefox" not in os.path.basename(cmd):
            continue
        try:
            total += int(_read(d / "statm").split()[1]) * page
        except (IndexError, ValueError):
            pass
    return round(total / 2**20, 1) if total else None


def hwmon_temps():
    """{"k10temp": °C, "amdgpu": °C, ...} from temp1_input of each hwmon."""
    out = {}
    for d in sorted((SYS / "class/hwmon").glob("hwmon*")):
        name = _read(d / "name").strip()
        t = _read(d / "temp1_input").strip()
        if name and t.lstrip("-").isdigit() and name not in out:
            out[name] = int(t) / 1000
    return out


def cpu_temp(temps):
    for name in ("k10temp", "coretemp", "zenpower", "cpu_thermal", "acpitz"):
        if name in temps:
            return temps[name]
    zones = [int(t) / 1000 for z in (SYS / "class/thermal").glob("thermal_zone*")
             if (t := _read(z / "temp").strip()).lstrip("-").isdigit()]
    return max(zones) if zones else None


def gpu_busy():
    for f in sorted((SYS / "class/drm").glob("card*/device/gpu_busy_percent")):
        v = _read(f).strip()
        if v.isdigit():
            return int(v)
    return None


def merge_frames(windows):
    """Combine the player's perf.json windows seen during one sample."""
    if not windows:
        return {}
    frames = sum(w.get("frames") or 0 for w in windows)
    span = sum(w.get("window") or 0 for w in windows)
    fm = [w.get("frame_ms") or {} for w in windows]

    def agg(key, fn):
        vals = [f[key] for f in fm if isinstance(f.get(key), (int, float))]
        return round(fn(vals), 2) if vals else None
    out = {
        "fps": round(frames / span, 1) if span else (windows[-1].get("fps")),
        "frame_p50": agg("p50", lambda v: sum(v) / len(v)),
        "frame_p95": agg("p95", max),
        "frame_p99": agg("p99", max),
        "frame_max": agg("max", max),
        "long_frames": sum(w.get("long_frames") or 0 for w in windows),
        "layout": next((w["layout"] for w in reversed(windows) if w.get("layout")), None),
    }
    active = {}
    for w in windows:
        for a in (w.get("active") or [])[:32]:
            if not isinstance(a, dict):
                continue
            key = (str(a.get("layer")), a.get("package"), a.get("version"), a.get("label"))
            cur = active.get(key)
            if not cur:
                active[key] = {k: a.get(k) for k in ("layer", "layer_name", "package", "version", "label", "from", "to")}
            else:
                if isinstance(a.get("from"), (int, float)) and (cur["from"] is None or a["from"] < cur["from"]):
                    cur["from"] = a["from"]
                cur["to"] = None if a.get("to") is None or cur["to"] is None else max(cur["to"], a["to"])
    for a in active.values():
        for k in ("from", "to"):
            if isinstance(a.get(k), float):
                a[k] = round(a[k], 1)
    out["active"] = [{k: v for k, v in a.items() if v is not None or k == "to"} for a in active.values()][:32]
    return out


class Perf:
    def __init__(self):
        self.samples = []
        self.acked = 0.0
        self.lock = threading.Lock()
        self.prev_cpu = cpu_times()
        self.windows = {}

    def read_player(self):
        p = read_json(RUN / "perf.json", None)
        if isinstance(p, dict) and isinstance(p.get("t"), (int, float)) and time.time() - p["t"] <= 30:
            self.windows[p["t"]] = p

    def sample(self):
        now = time.time()
        cur = cpu_times()
        s = {"t": round(now, 1)}

        def pct(name):
            a, b = self.prev_cpu.get(name), cur.get(name)
            if not a or not b or b[1] <= a[1]:
                return None
            return round(100 * (b[0] - a[0]) / (b[1] - a[1]), 1)
        s["cpu"] = pct("cpu")
        cores = [x for x in (pct(k) for k in cur if k != "cpu") if x is not None]
        s["cpu_max_core"] = max(cores) if cores else None
        self.prev_cpu = cur
        try:
            s["load1"] = float(_read(PROC / "loadavg").split()[0])
        except (IndexError, ValueError):
            s["load1"] = None
        m = meminfo()
        if "MemTotal" in m:
            s["mem_total_mb"] = round(m["MemTotal"] / 1024)
            s["mem_used_mb"] = round((m["MemTotal"] - m.get("MemAvailable", m.get("MemFree", 0))) / 1024)
        s["ff_rss_mb"] = firefox_rss_mb()
        temps = hwmon_temps()
        s["temp_cpu"] = cpu_temp(temps)
        s["temp_gpu"] = temps.get("amdgpu")
        s["gpu_busy"] = gpu_busy()
        self.read_player()
        wins = [w for t, w in sorted(self.windows.items()) if t > now - PERF_EVERY - 2.5]
        self.windows = {}
        s.update(merge_frames(wins))
        with self.lock:
            self.samples = (self.samples + [s])[-PERF_KEEP:]
        return s

    def run(self):
        next_at = time.monotonic() + PERF_EVERY
        while True:
            time.sleep(2.5)
            try:
                self.read_player()
                if time.monotonic() >= next_at:
                    next_at += PERF_EVERY
                    self.sample()
            except Exception as e:  # never let stats take the agent down
                log(f"perf sample failed: {type(e).__name__}: {e}")

    def pending(self):
        with self.lock:
            return [x for x in self.samples if x["t"] > self.acked][:PERF_BATCH]

    def ack(self, t):
        if isinstance(t, (int, float)):
            with self.lock:
                self.acked = max(self.acked, t)
                self.samples = [x for x in self.samples if x["t"] > self.acked]


class Agent:
    def __init__(self):
        self.st = read_json(AGENT_STATE, {})
        self.results = []
        self.lock = threading.Lock()
        self.save_lock = threading.Lock()
        self.wake = threading.Event()
        self.reboot_requested = False
        self.poll = 15
        self.failures = 0
        self.perf = Perf()
        self.syncing = False
        self.sync_next = None

    # ---- status files for the on-screen overlay (/run/signage, no secrets)

    def set_update(self, state, percent=None, message="", version=None):
        u = dict(self.st.get("update") or {})
        old = (u.get("state"), (u.get("percent") or 0) // 5)
        u.update(state=state, message=message[:300], updated=int(time.time() * 1000))
        if percent is not None:
            u["percent"] = max(0, min(100, int(percent)))
        if version is not None:
            u["version"] = version
        self.st["update"] = u
        try:
            write_atomic(RUN / "update.json", json.dumps(u))
        except OSError:
            pass
        self.save()
        if (u["state"], (u.get("percent") or 0) // 5) != old:
            self.wake.set()  # report phase changes and each 5% promptly

    def finish_update_after_boot(self):
        """After an update's reboot, record whether we came up on the new version."""
        u = self.st.get("update") or {}
        if u.get("state") != "rebooting":
            return
        current = os_release().get("IMAGE_VERSION", "")
        if u.get("version") and current != u["version"]:
            self.set_update("failed", 100, f"still on {current} after reboot (boot fell back to the old version?)")
        else:
            self.set_update("done", 100, f"running {current}")

    def write_agent_status(self, state, error=None):
        url = self.dashboard()[0]
        ident = read_json(IDENTITY, {})
        now = int(time.time() * 1000)
        if state == "connected":
            self.st["last_ok"] = now
        info = {
            "state": state,
            "dashboard": urllib.parse.urlsplit(url).hostname if url else None,
            "device": socket.gethostname(),
            "device_id": ident.get("device_id"),
            "last_ok": self.st.get("last_ok"),
            "last_attempt": now,
            "error": (str(error)[:200] if error else None),
            "content_generation": read_json(CONTENT, {}).get("generation", 0),
        }
        try:
            write_atomic(RUN / "agent.json", json.dumps(info))
        except OSError:
            pass

    def save(self):
        with self.save_lock:
            keep = {k: v for k, v in self.st.items() if k not in ("display_cache", "display_at")}
            write_atomic(AGENT_STATE, json.dumps(keep, indent=1), 0o600)

    def result(self, cid, ok, output=""):
        with self.lock:
            self.results.append({"id": cid, "ok": ok, "output": str(output)[-8000:]})
        self.wake.set()

    # ---- config and identity

    def dashboard(self):
        cfg = merge(load_toml(CONFIG), load_toml(OVERRIDES))
        d = cfg.get("dashboard", {})
        return (d.get("url") or "").rstrip("/"), d.get("enroll_token") or ""

    def identity(self, url, token):
        ident = read_json(IDENTITY, None)
        if ident and ident.get("url") == url:
            return ident
        r = http_json(f"{url}/device/enroll", {
            "enroll_token": token, "mac": primary_mac(), "hostname": socket.gethostname(),
            "machine_id": Path("/etc/machine-id").read_text().strip() if Path("/etc/machine-id").exists() else "",
        })
        ident = {"url": url, "device_id": r["device_id"], "token": r["token"]}
        write_atomic(IDENTITY, json.dumps(ident), 0o600)
        log(f"enrolled as {ident['device_id']}")
        return ident

    # ---- settings

    def apply_settings(self, settings, rev):
        if rev == self.st.get("bad_settings_rev"):
            return  # rolled back once already; wait for new settings
        header = "# Written by signage-agent from the dashboard. Local edits are overwritten.\n"
        text = toml_dumps(settings, header) if settings else ""
        old_text = OVERRIDES.read_text() if OVERRIDES.exists() else ""
        if text == old_text:
            self.st["settings_rev"] = rev
            self.st.pop("settings_error", None)
            return
        # Check the merged result with the device's own validator: an invalid
        # config would make signage-config fall back to defaults (no WiFi).
        merged = merge(load_toml(CONFIG), settings)
        with tempfile.NamedTemporaryFile("w", suffix=".toml", dir=AGENT, delete=False) as f:
            f.write(toml_dumps(merged))
            tmp = f.name
        try:
            chk = run([SIGNAGE_CONFIG, "--check", tmp])
        finally:
            os.unlink(tmp)
        if chk.returncode != 0:
            self.st["settings_error"] = " ".join(chk.stdout.split())[:500] or chk.stderr.strip()[:500]
            log(f"rejected dashboard settings rev {rev}: {self.st['settings_error']}")
            return
        old = load_toml(OVERRIDES)
        if old_text:
            write_atomic(OVERRIDES_PREV, old_text, 0o600)
        else:
            OVERRIDES_PREV.unlink(missing_ok=True)
        if text:
            write_atomic(OVERRIDES, text, 0o600)
        else:
            OVERRIDES.unlink(missing_ok=True)
        net_changed = old.get("network") != settings.get("network") or old.get("ntp") != settings.get("ntp")
        disp_changed = old.get("display") != settings.get("display")
        log(f"applying dashboard settings rev {rev}")
        if not DRY_RUN:
            r = run([SIGNAGE_CONFIG, "--reload"], timeout=60)
            if r.returncode != 0:
                log(f"signage-config --reload failed: {r.stderr.strip()[:300]}")
            if disp_changed:
                run(["systemctl", "restart", "signage-player.service"])
        self.st["settings_rev"] = rev
        self.st.pop("settings_error", None)
        self.st.pop("rolled_back", None)
        self.st["display_at"] = 0
        if net_changed:
            self.st["rollback"] = {"deadline": time.time() + ROLLBACK_AFTER, "rev": rev,
                                   "prev_rev": self.st.get("prev_settings_rev", 0)}
        self.st["prev_settings_rev"] = rev
        self.save()

    def maybe_roll_back(self):
        rb = self.st.get("rollback")
        if not rb or time.time() < rb["deadline"]:
            return
        log("no contact with the dashboard since the network change; rolling back")
        if OVERRIDES_PREV.exists():
            os.replace(OVERRIDES_PREV, OVERRIDES)
        else:
            OVERRIDES.unlink(missing_ok=True)
        if not DRY_RUN:
            run([SIGNAGE_CONFIG, "--reload"], timeout=60)
        self.st["bad_settings_rev"] = rb["rev"]
        self.st["settings_rev"] = rb["prev_rev"]
        self.st["prev_settings_rev"] = rb["prev_rev"]
        self.st["rolled_back"] = f"settings rev {rb['rev']} cut the device off, restored the previous ones"
        self.st.pop("rollback", None)
        self.save()

    # ---- content

    def sync_content(self, content):
        PACKAGES.mkdir(parents=True, exist_ok=True)
        try:
            for p in content.get("packages", []):
                dest = PACKAGES / p["id"] / p["version"]
                marker = dest / ".signage-sha256"
                if marker.exists() and marker.read_text().strip() == p["sha256"]:
                    continue
                self.install_package(p, dest)
        except Exception as e:
            self.st["content_error"] = f"package download failed: {e}"
            log(self.st["content_error"])
            return False
        out = {k: v for k, v in content.items() if k != "packages"}
        out["packages"] = [{k: v for k, v in p.items() if k != "url"} for p in content.get("packages", [])]
        for layer in out.get("layers", []):
            for it in layer.get("items", []):
                it["path"] = str(PACKAGES / it["package"] / it["version"])
                it["url"] = f"/packages/{urllib.parse.quote(it['package'])}/{urllib.parse.quote(it['version'])}/"
        out["generation"] = int(read_json(CONTENT, {}).get("generation", 0)) + 1
        out["written"] = time.time()
        write_atomic(CONTENT, json.dumps(out, indent=1))
        self.st.pop("content_error", None)
        self.prune(content)
        log(f"content rev {content.get('rev')} ready (generation {out['generation']})")
        return True

    def install_package(self, p, dest):
        log(f"downloading {p['id']} {p['version']}")
        tmpdir = Path(tempfile.mkdtemp(dir=PACKAGES, prefix=".dl-"))
        try:
            zpath = tmpdir / "pkg.zip"
            download(p["url"], zpath, p["sha256"], p.get("size"))
            root = p.get("root", "")
            out = tmpdir / "out"
            out.mkdir()
            with zipfile.ZipFile(zpath) as z:
                for info in z.infolist():
                    name = info.filename
                    if root:
                        if not name.startswith(root):
                            continue
                        name = name[len(root):]
                    if not name or name.endswith("/"):
                        continue
                    target = (out / name).resolve()
                    if out.resolve() not in target.parents:
                        raise ValueError(f"unsafe path {info.filename}")
                    target.parent.mkdir(parents=True, exist_ok=True)
                    with z.open(info) as src, open(target, "wb") as dst:
                        shutil.copyfileobj(src, dst)
            (out / ".signage-sha256").write_text(p["sha256"] + "\n")
            for f in [out, *out.rglob("*")]:
                os.chmod(f, 0o755 if f.is_dir() else 0o644)
            dest.parent.mkdir(parents=True, exist_ok=True)
            if dest.exists():
                shutil.rmtree(dest)
            os.replace(out, dest)
        finally:
            shutil.rmtree(tmpdir, ignore_errors=True)

    def prune(self, content):
        keep = {(p["id"], p["version"]) for p in content.get("packages", [])}
        for pkg in PACKAGES.iterdir():
            if pkg.name.startswith(".") or not pkg.is_dir():
                if pkg.name.startswith(".dl-"):
                    shutil.rmtree(pkg, ignore_errors=True)
                continue
            for ver in pkg.iterdir():
                if (pkg.name, ver.name) not in keep:
                    shutil.rmtree(ver, ignore_errors=True)
            if not any(pkg.iterdir()):
                pkg.rmdir()

    # ---- commands

    def command(self, cmd):
        cid, ctype, args = cmd["id"], cmd["type"], cmd.get("args") or {}
        log(f"command {ctype} ({cid})")
        if ctype in ("terminal", "os-update"):
            threading.Thread(target=self._threaded, args=(cid, ctype, args), daemon=True).start()
            return
        try:
            if ctype == "reboot":
                self.result(cid, True, "rebooting")
                self.reboot_requested = True
            elif ctype == "restart-player":
                r = run(["systemctl", "restart", "signage-player.service"])
                self.result(cid, r.returncode == 0, r.stderr)
            elif ctype == "screenshot":
                self.result(cid, *self.screenshot(args))
            elif ctype == "resync":
                self.st["content_rev"] = ""
                self.st["force_verify"] = True
                self.result(cid, True, "content will be fetched again")
            else:
                self.result(cid, False, f"unknown command {ctype}")
        except Exception as e:
            self.result(cid, False, f"{type(e).__name__}: {e}")

    def _threaded(self, cid, ctype, args):
        try:
            if ctype == "terminal":
                self.result(cid, True, terminal_session(args))
            elif ctype == "os-update":
                ok, out = self.os_update(args.get("version") or "")
                self.result(cid, ok, out)
        except Exception as e:
            self.result(cid, False, f"{type(e).__name__}: {e}")

    def os_update(self, version):
        current = os_release().get("IMAGE_VERSION", "")
        self.set_update("checking", 0, "looking for a new version", version or None)
        if not version:
            r = run([SYSUPDATE, "check-new"], timeout=120)
            found = r.stdout.strip().splitlines()[-1].strip() if r.returncode == 0 and r.stdout.strip() else ""
            if not found or found == current:
                self.set_update("done", 100, f"already up to date ({current})", current)
                return True, (r.stdout + r.stderr).strip() or "already up to date"
            version = found
            self.set_update("checking", 2, f"found {version}", version)
        self.set_update("downloading", 3, f"downloading {version}", version)
        log_tail = []
        p = subprocess.Popen([SYSUPDATE, "update", version], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                             text=True, errors="replace", bufsize=1)
        # sysupdate's download helper prints "Got NN% of <url>. ..." per file, and each
        # file (usr, verity, UKI) restarts at 0%. Map each file onto its own band, by
        # rough share of the bytes, and never let the bar go backwards.
        bands = {"usr": (3, 88), "verity": (88, 91), "efi": (91, 94), "other": (91, 94)}

        def band(url):
            u = url.lower()
            if "verity" in u:
                return "verity"
            if ".usr" in u or "usr-" in u:
                return "usr"
            if ".efi" in u:
                return "efi"
            return "other"

        def bump(state, pct, msg):
            cur = self.st["update"].get("percent", 0) or 0
            self.set_update(state, max(cur, pct), msg, version)

        for line in p.stdout:
            line = line.rstrip()
            if not line:
                continue
            log_tail = (log_tail + [line])[-60:]
            m = re.search(r"Got (\d{1,3})(?:\.\d+)?% of (\S+?)\.?(?:\s|$)", line) \
                or re.search(r"(\d{1,3})(?:\.\d+)?%.*?(\S*(?:usr|verity|efi)\S*)", line)
            if m:
                lo, hi = bands[band(m.group(2))]
                pct = min(int(m.group(1)), 100)
                bump("downloading", round(lo + (hi - lo) * pct / 100, 1), line)
            elif re.match(r"(?i)\s*successfully installed", line):
                bump("installing", 95, line)
        rc = p.wait()
        out = "\n".join(log_tail)[-6000:]
        if rc != 0:
            self.set_update("failed", self.st["update"].get("percent", 0), (log_tail or ["sysupdate failed"])[-1], version)
            return False, out
        if "No update needed" in out:
            self.set_update("done", 100, f"already on {version}", version)
            return True, out
        self.set_update("rebooting", 100, f"rebooting into {version}", version)
        self.reboot_requested = True
        return True, out + "\nrebooting into the new version"

    def screenshot(self, args):
        env = wayland_env()
        if not env:
            return False, "no Wayland session (is the player running?)"
        r = subprocess.run(["grim", "-t", "png", "-"], env=env, capture_output=True, timeout=20)
        if r.returncode != 0:
            return False, r.stderr.decode(errors="replace")[:500]
        req = urllib.request.Request(args["upload_url"], data=r.stdout, method="PUT",
                                     headers={"Content-Type": "image/png"})
        with urllib.request.urlopen(req, timeout=60):
            pass
        return True, f"{len(r.stdout)} bytes"

    # ---- main loop

    def checkin(self, url, ident):
        with self.lock:
            results, self.results = self.results, []
        body = {
            "time": time.time(),
            "status": status(self.st),
            "settings_rev": self.st.get("settings_rev", 0),
            "content_rev": self.st.get("content_rev") or read_json(CONTENT, {}).get("rev", ""),
            "results": results,
        }
        perf = self.perf.pending()
        if perf:
            body["perf"] = perf
        if self.st.get("force_verify"):
            body["content_rev"] = ""
        try:
            return http_json(f"{url}/device/checkin", body,
                             auth=f"Device {ident['device_id']}:{ident['token']}")
        except Exception:
            with self.lock:
                self.results = results + self.results  # report them next time
            raise

    def start_sync(self, content):
        """Download packages in the background so check-ins keep flowing (and the
        device stays online on the dashboard) while a big first sync runs. The
        dashboard resends the content on every check-in until content_rev
        matches, so a newer rev that arrives meanwhile is picked up next."""
        with self.lock:
            self.sync_next = content
            if self.syncing:
                return
            self.syncing = True
        if self.st.pop("force_verify", False):
            for marker in PACKAGES.glob("*/*/.signage-sha256"):
                marker.unlink()

        def work():
            try:
                while True:
                    with self.lock:
                        c, self.sync_next = self.sync_next, None
                        if c is None or c.get("rev") == self.st.get("content_rev"):
                            self.syncing = False
                            return
                    if self.sync_content(c):
                        self.st["content_rev"] = c.get("rev", "")
                        self.save()
                        self.wake.set()   # report the new rev now
                    else:
                        with self.lock:
                            self.syncing = False
                        return            # retried with the next check-in's content
            except Exception as e:
                log(f"content sync failed: {type(e).__name__}: {e}")
                with self.lock:
                    self.syncing = False

        threading.Thread(target=work, daemon=True, name="sync").start()

    def handle(self, resp):
        self.poll = max(2, min(300, int(resp.get("poll_interval", 15))))
        self.perf.ack(resp.get("perf_ack"))
        if self.st.pop("rollback", None):
            log("dashboard reachable after the network change; keeping it")
        if "settings" in resp:
            self.apply_settings(resp["settings"] or {}, int(resp.get("settings_rev", 0)))
        if "content" in resp:
            self.start_sync(resp["content"])
        for cmd in resp.get("commands", []):
            self.command(cmd)
        self.save()

    def loop(self):
        AGENT.mkdir(parents=True, exist_ok=True)
        os.chmod(AGENT, 0o700)
        self.finish_update_after_boot()
        threading.Thread(target=self.perf.run, daemon=True, name="perf").start()
        while True:
            url, token = self.dashboard()
            if not url:
                self.write_agent_status("unconfigured", "no [dashboard] url in config.toml")
                time.sleep(60)
                continue
            if self.failures == 0 and not self.st.get("last_ok"):
                self.write_agent_status("connecting")
            try:
                ident = self.identity(url, token)
                resp = self.checkin(url, ident)
                self.failures = 0
                self.write_agent_status("connected")
                self.handle(resp)
            except Unauthorized as e:
                log(f"dashboard refused our credentials ({e}); enrolling again")
                IDENTITY.unlink(missing_ok=True)
                self.failures += 1
                self.write_agent_status("error", f"dashboard refused this device: {e}")
            except Exception as e:
                self.failures += 1
                self.write_agent_status("offline" if self.st.get("last_ok") else "connecting",
                                        f"{type(e).__name__}: {e}")
                if self.failures in (1, 5) or self.failures % 60 == 0:
                    log(f"check-in failed ({type(e).__name__}: {e}); playing from cache")
                self.maybe_roll_back()
            if self.reboot_requested:
                with self.lock:
                    pending = bool(self.results)
                if not pending or self.failures:
                    log("rebooting")
                    if not DRY_RUN:
                        run(["systemctl", "reboot"])
                    return
                continue  # report the result first, then reboot
            # Retry quickly while offline: right after boot the first attempts
            # often fail (link coming up, clock not yet stepped by NTP so TLS
            # rejects certificates), and a long backoff delays the first
            # check-in by minutes.
            delay = self.poll if not self.failures else min(15, 3 * self.failures)
            self.wake.wait(delay)
            self.wake.clear()


def main():
    if os.geteuid() != 0 and not DRY_RUN:
        log("must run as root")
        return 1
    Agent().loop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
