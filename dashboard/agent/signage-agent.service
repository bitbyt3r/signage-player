[Unit]
Description=Signage dashboard agent (check-in, settings, content sync, remote commands)
Documentation=file:///usr/share/doc/signage/dashboard.md
# Not network-online.target: the agent retries every 3-15 s until it gets
# through, so waiting for NetworkManager-wait-online (up to 60 s, longer with
# configured WiFi networks that are out of range) only delays the first
# check-in after boot.
After=signage-config.service
ConditionPathExists=!/run/signage/installer

[Service]
Type=simple
ExecStart=/usr/lib/signage/signage-agent
Restart=always
RestartSec=10
# Players can be offline for days; the agent keeps retrying on its own and
# never blocks boot.
TimeoutStartSec=0
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
