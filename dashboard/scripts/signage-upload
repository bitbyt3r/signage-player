#!/usr/bin/env python3
"""Upload OGraf packages to the signage dashboard from a terminal.

    signage-upload path/to/graphic-folder          # zipped for you
    signage-upload graphic.zip other.zip           # package zips
    signage-upload bundle.zip                      # a zip of package zips
    signage-upload packages/                       # every package folder or zip in it
    signage-upload --list                          # what the dashboard has

Each package is uploaded and made the active version (so devices pick it up
at their next check-in) unless --no-activate is given. The version comes from
the manifest: re-uploading identical files is a no-op, while changed files
under an existing version are refused, so bump "version" in the manifest
with every change.

The dashboard URL and an upload token (Packages page, Upload tokens) come
from --url/--token, the SIGNAGE_URL/SIGNAGE_TOKEN environment variables, or a
JSON file {"url": ..., "token": ...} named .signage-upload in the current
directory or any parent (git-ignored in this repository), --config FILE, or
~/.config/signage/upload.json.

Only the Python standard library is needed.
"""
import argparse
import io
import json
import os
import sys
import urllib.error
import urllib.request
import zipfile
from pathlib import Path

SKIP_DIRS = {".git", "node_modules", "__MACOSX", ".venv", "__pycache__"}
FIXED_TIME = (1980, 1, 1, 0, 0, 0)  # zips of the same files are byte-identical


def find_config(path=None):
    if path:
        return json.loads(Path(path).read_text())
    for d in [Path.cwd(), *Path.cwd().parents]:
        f = d / ".signage-upload"
        if f.is_file():
            return json.loads(f.read_text())
    f = Path.home() / ".config" / "signage" / "upload.json"
    return json.loads(f.read_text()) if f.is_file() else {}


def is_manifest(name):
    return name.endswith(".ograf.json") and "__MACOSX" not in name and not Path(name).name.startswith("._")


def zip_folder(folder):
    """Zip a package folder deterministically (sorted, fixed timestamps)."""
    buf = io.BytesIO()
    files = []
    for root, dirs, names in os.walk(folder):
        dirs[:] = sorted(d for d in dirs if d not in SKIP_DIRS and not d.startswith("."))
        for n in names:
            if n.startswith(".") or n.endswith(".zip"):
                continue
            files.append(Path(root) / n)
    with zipfile.ZipFile(buf, "w", zipfile.ZIP_DEFLATED) as z:
        for f in sorted(files):
            info = zipfile.ZipInfo(f.relative_to(folder).as_posix(), FIXED_TIME)
            info.compress_type = zipfile.ZIP_DEFLATED
            info.external_attr = 0o644 << 16
            z.writestr(info, f.read_bytes())
    return buf.getvalue()


def zip_entries(data):
    with zipfile.ZipFile(io.BytesIO(data)) as z:
        names = z.namelist()
        if any(is_manifest(n) for n in names):
            return None
        inner = [n for n in names if n.lower().endswith(".zip") and "__MACOSX" not in n
                 and not Path(n).name.startswith("._")]
        return [(n, z.read(n)) for n in sorted(inner)] or None


def collect(path):
    """(label, zip bytes) for every package at path."""
    p = Path(path)
    if p.is_dir():
        if any(is_manifest(f.name) for f in p.iterdir() if f.is_file()):
            return [(str(p), zip_folder(p))]
        out = []
        for child in sorted(p.iterdir()):
            if child.name.startswith(".") or child.name in SKIP_DIRS:
                continue
            if child.is_dir() and any(is_manifest(f.name) for f in child.rglob("*.ograf.json")):
                out += collect(child)
            elif child.suffix.lower() == ".zip":
                out += collect(child)
        if not out:
            raise SystemExit(f"{p}: no *.ograf.json manifest or package zips in it")
        return out
    data = p.read_bytes()
    try:
        inner = zip_entries(data)
    except zipfile.BadZipFile:
        raise SystemExit(f"{p}: not a zip file or a folder")
    if inner:
        return [(f"{p}: {n}", d) for n, d in inner]
    return [(str(p), data)]


class Dashboard:
    def __init__(self, url, token):
        self.url = url.rstrip("/")
        self.token = token

    def call(self, method, path, body=None):
        req = urllib.request.Request(self.url + path, method=method,
                                     data=None if body is None else json.dumps(body).encode(),
                                     headers={"Authorization": f"Bearer {self.token}",
                                              "Content-Type": "application/json",
                                              "User-Agent": "signage-upload"})
        try:
            with urllib.request.urlopen(req, timeout=60) as r:
                return json.loads(r.read() or b"{}")
        except urllib.error.HTTPError as e:
            try:
                err = json.loads(e.read())
            except ValueError:
                err = {}
            msg = err.get("error") or f"HTTP {e.code}"
            if err.get("errors"):
                msg += ": " + "; ".join(map(str, err["errors"]))
            raise RuntimeError(msg) from None

    def upload(self, data, version=None, activate=True):
        u = self.call("POST", "/api/packages/upload")
        put = urllib.request.Request(u["url"], data=data, method="PUT",
                                     headers={"Content-Type": "application/zip"})
        try:
            urllib.request.urlopen(put, timeout=300).read()
        except urllib.error.HTTPError as e:
            raise RuntimeError(f"upload to storage failed (HTTP {e.code})") from None
        body = {"key": u["key"], "activate": activate}
        if version:
            body["version"] = version
        return self.call("POST", "/api/packages/import", body)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog=__doc__.split("\n\n", 1)[1])
    ap.add_argument("paths", nargs="*", help="package folders, package zips, bundles, or folders of them")
    ap.add_argument("--no-activate", action="store_true", help="upload without making it the active version")
    ap.add_argument("--version", help="version to store (one package only; default: the manifest's)")
    ap.add_argument("--list", action="store_true", help="list the dashboard's packages and active versions")
    ap.add_argument("--url", help="dashboard URL (or SIGNAGE_URL)")
    ap.add_argument("--token", help="upload token (or SIGNAGE_TOKEN)")
    ap.add_argument("--config", help='a JSON file {"url": ..., "token": ...} to use instead of .signage-upload')
    a = ap.parse_args()
    cfg = find_config(a.config)
    url = a.url or os.environ.get("SIGNAGE_URL") or cfg.get("url")
    token = a.token or os.environ.get("SIGNAGE_TOKEN") or cfg.get("token")
    if not url or not token:
        raise SystemExit("set the dashboard URL and an upload token: see --help")
    dash = Dashboard(url, token)

    if a.list:
        for p in dash.call("GET", "/api/packages")["packages"]:
            vers = ", ".join(v["version"] for v in p["versions"][:5])
            print(f"{p['id']}  active {p['active_version']}  ({vers})")
        if not a.paths:
            return 0
    if not a.paths:
        ap.error("give at least one package folder or zip")

    jobs = [j for path in a.paths for j in collect(path)]
    if a.version and len(jobs) != 1:
        raise SystemExit("--version only works with a single package")
    failed = 0
    for label, data in jobs:
        try:
            r = dash.upload(data, a.version, not a.no_activate)
        except RuntimeError as e:
            print(f"FAILED  {label}: {e}", file=sys.stderr)
            failed += 1
            continue
        state = "unchanged" if r.get("unchanged") else "uploaded"
        active = " (active)" if r.get("active_version") == r["version"] else \
            f" (active is {r['active_version']})" if r.get("active_version") else ""
        print(f"{state:9} {r['id']} {r['version']}{active}  from {label}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
