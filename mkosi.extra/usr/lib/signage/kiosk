#!/bin/bash
# Runs inside cage as the signage user: applies display settings, then
# starts Firefox full screen.
set -uo pipefail

DISPLAY_JSON=/run/signage/display.json
STATUS_DIR=${RUNTIME_DIRECTORY:-/run/signage-kiosk}
if [[ -n ${SIGNAGE_URL:-} ]]; then
    URL=$SIGNAGE_URL
else
    # The player page plays the dashboard's program (/content.json) and
    # shows the status screen when there's nothing to play. [player]
    # demo = true makes it play the demo lower third instead of the status
    # screen while no program is assigned.
    URL=http://127.0.0.1:8080/player/
    if [[ $(jq -r '.demo // false' /run/signage/player.json 2>/dev/null) == true ]]; then
        URL+="?demo=1"
    fi
fi

apply_display() {
    rm -f "$STATUS_DIR/outputs.json"
    [[ -r $DISPLAY_JSON ]] || return 0
    local mode custom rotation output scale transform
    mode=$(jq -r '.mode // ""' "$DISPLAY_JSON")
    custom=$(jq -r '.custom // false' "$DISPLAY_JSON")
    rotation=$(jq -r '.rotation // 0' "$DISPLAY_JSON")
    output=$(jq -r '.output // ""' "$DISPLAY_JSON")
    scale=$(jq -r '.scale // 1' "$DISPLAY_JSON")
    case $rotation in 90|180|270) transform=$rotation ;; *) transform=normal ;; esac

    local all span outputs
    all=$(wlr-randr | awk '/^[^ ]/ {print $1}')
    mapfile -t span < <(jq -r '.span // [] | .[]' "$DISPLAY_JSON")
    if (( ${#span[@]} )); then
        # [display] span: one page across these outputs, left to right.
        # cage stretches its one full-screen window over every enabled
        # output, so turn the others off and place these side by side.
        outputs=""
        for o in "${span[@]}"; do
            if grep -qxF -- "$o" <<<"$all"; then outputs+="$o"$'\n'; else echo "kiosk: span output $o isn't connected" >&2; fi
        done
        for o in $all; do
            grep -qxF -- "$o" <<<"$outputs" || wlr-randr --output "$o" --off || echo "kiosk: couldn't turn off $o" >&2
        done
    elif [[ -n $output ]]; then
        outputs=$output
    else
        outputs=$all
    fi
    for o in $outputs; do
        local args=(--output "$o" --on --transform "$transform" --scale "$scale")
        if [[ -n $mode ]]; then
            if [[ $custom == true ]]; then args+=(--custom-mode "$mode"); else args+=(--mode "$mode"); fi
        fi
        wlr-randr "${args[@]}" || echo "kiosk: wlr-randr failed for $o" >&2
    done
    (( ${#span[@]} )) || return 0

    # Side by side, each output's logical size (mode, rotated, / scale).
    # The player reads outputs.json to tell graphics where each screen is.
    local x=0 w h list="[]" json
    json=$(wlr-randr --json) || { echo "kiosk: wlr-randr --json failed" >&2; return 0; }
    for o in $outputs; do
        read -r w h < <(jq -r --arg o "$o" '
            .[] | select(.name == $o) | ((.scale // 1) | if . <= 0 then 1 else . end) as $s
            | (.modes[] | select(.current)) as $m
            | (if (.transform | tostring | test("90|270")) then [$m.height, $m.width] else [$m.width, $m.height] end)
            | map(. / $s | floor) | "\(.[0]) \(.[1])"' <<<"$json" 2>/dev/null)
        [[ -n ${w:-} ]] || { echo "kiosk: no current mode for $o" >&2; continue; }
        wlr-randr --output "$o" --pos "$x,0" || echo "kiosk: couldn't place $o" >&2
        list=$(jq -c --arg o "$o" --argjson x "$x" --argjson w "$w" --argjson h "$h" '. + [{name: $o, x: $x, y: 0, width: $w, height: $h}]' <<<"$list")
        x=$((x + w))
    done
    echo "kiosk: spanning $(jq -r 'map("\(.name) \(.width)x\(.height)+\(.x)") | join(", ")' <<<"$list")" >&2
    local tmp
    tmp=$(mktemp "$STATUS_DIR/.outputs.XXXXXX") && jq . <<<"$list" >"$tmp" && chmod 644 "$tmp" && mv -f "$tmp" "$STATUS_DIR/outputs.json"
}

# The dashboard agent's connection, from its /run/signage/agent.json:
# sets dash (text, HTML-escaped) and dashcls (a colour).
dashboard_status() {
    local a=/run/signage/agent.json now state
    now=$(date +%s)
    state=$(jq -r '.state // ""' "$a" 2>/dev/null)
    case $state in
        "") dash="agent not running"; dashcls="#8a949c" ;;
        unconfigured) dash="not configured"; dashcls="#8a949c" ;;
        connected)
            dash=$(jq -r --argjson now "$now" '"connected · checked in \(($now - ((.last_ok // .last_attempt) / 1000 | floor)) | if . < 0 then 0 else . end) s ago"' "$a")
            dashcls="#8be08b" ;;
        *)
            dash=$(jq -r 'if .last_ok then "offline since " + (.last_ok / 1000 | floor | strflocaltime("%H:%M")) else "connecting" end
                          + (if .error then " — " + .error else "" end)' "$a")
            dashcls="#ffc266" ;;
    esac
    dash=$(sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' <<<"$dash")
}

# Device status, as status.json (the player's status screen and the host
# page's overlay read it through signage-web) and as a plain status page
# (file://, for SIGNAGE_URL or when signage-web is down).
write_status() {
    local tmp version addrs clock ntp config display dash dashcls
    . /usr/lib/os-release
    version=${IMAGE_VERSION:-dev}
    addrs=$(ip -o -4 addr show scope global | awk '{print $2": "$4}' | paste -sd ' ' -)
    clock=$(date '+%Y-%m-%d %H:%M:%S %Z')
    # chronyc can't reach chronyd as a non-root user (Debian runs it as
    # chronyd-restricted, with no command port), so ask the kernel via timedated.
    case $(timedatectl show -p NTPSynchronized --value 2>/dev/null) in
        yes) ntp="NTP synced" ;; no) ntp="NTP not synced" ;; *) ntp="" ;;
    esac
    config=$(jq -r '.source + (if (.errors|length)>0 then " — ERRORS: " + (.errors|join("; ")) else "" end)' /run/signage/config-status.json 2>/dev/null)
    display=$(jq -c . "$DISPLAY_JSON" 2>/dev/null)
    dashboard_status

    tmp=$(mktemp "$STATUS_DIR/.status.XXXXXX") || return
    jq -n --arg hostname "$(hostname)" --arg version "$version" --arg addresses "$addrs" \
        --arg clock "$clock" --arg ntp "${ntp:-unknown}" --arg config "$config" --arg display "$display" \
        '$ARGS.named' >"$tmp"
    chmod 644 "$tmp"; mv -f "$tmp" "$STATUS_DIR/status.json"

    tmp=$(mktemp "$STATUS_DIR/.status.XXXXXX") || return
    cat >"$tmp" <<HTML
<!doctype html><meta charset="utf-8"><meta http-equiv="refresh" content="5">
<title>signage</title>
<style>
body{margin:0;height:100vh;display:grid;place-content:center;background:#101418;color:#e8eef2;
font:2.2vw/1.5 "DejaVu Sans",sans-serif}
h1{font-size:4vw;margin:0 0 .5em}dt{color:#8aa0b0}dd{margin:0 0 .6em}code{font-size:1.6vw}
</style>
<h1>$(hostname)</h1><dl>
<dt>Version</dt><dd>$version</dd>
<dt>Addresses</dt><dd>${addrs:-none}</dd>
<dt>Clock</dt><dd>$clock (${ntp:-unknown})</dd>
<dt>Config</dt><dd><code>$config</code></dd>
<dt>Display</dt><dd><code>$display</code></dd>
<dt>Dashboard</dt><dd style="color:$dashcls">$dash</dd>
</dl>
HTML
    chmod 644 "$tmp"; mv -f "$tmp" "$STATUS_DIR/status.html"
}

apply_display
# The agent's update progress and connection state, for the host page
# and the player (signage-web serves this directory as /status/).
ln -sf /run/signage/update.json "$STATUS_DIR/update.json"
ln -sf /run/signage/agent.json "$STATUS_DIR/agent.json"
# display.json's layout (screen or arch) is read by the player page.
ln -sf "$DISPLAY_JSON" "$STATUS_DIR/display.json"
write_status
( while sleep 5; do write_status; done ) &
status_pid=$!

# signage-web is only ordered before us, not waited for; give it a moment.
if [[ $URL == http://127.0.0.1:8080/* ]]; then
    for _ in $(seq 60); do curl -fs -o /dev/null http://127.0.0.1:8080/host/ && break; sleep 0.5; done
fi

# The biggest screen's size in pixels, as Firefox draws to it ("W H"), for
# WebRender's tiles below. Nothing if wlr-randr can't say.
screen_size() {
    wlr-randr --json 2>/dev/null | jq -r '
        [.[] | select(.enabled) | (.modes[] | select(.current)) as $m
         | if (.transform | tostring | test("90|270")) then [$m.height, $m.width] else [$m.width, $m.height] end]
        | max_by(.[0] * .[1]) // empty | "\(.[0]) \(.[1])"' 2>/dev/null
}
# WebRender keeps the page in tiles and draws again every tile that changed.
# Its tiles are 1024x512, 32 of them on a 4K screen, and a full-screen
# graphic with anything moving in it changes all of them on every frame: on
# an M715q at 4K60 that bookkeeping alone kept Firefox's main process at
# about 42% of a core. With one tile the size of the screen the same picture
# takes about 24%.
tile_w=1024 tile_h=512
if read -r w h < <(screen_size) && [[ ${w:-} =~ ^[0-9]+$ && ${h:-} =~ ^[0-9]+$ ]] && (( w >= 1024 && h >= 512 )); then
    tile_w=$w tile_h=$h
fi

# Firefox refuses a --profile directory that does not exist yet.
mkdir -p "$HOME/firefox"
# Prefs for the player, rewritten every start. Firefox copies user.js into
# prefs.js, so a pref dropped from here keeps its old value: set it back
# explicitly instead of deleting the line.
cat >"$HOME/firefox/user.js" <<PREFS
// Written by /usr/lib/signage/kiosk at every start; edits are lost.
// The player reports WebGL's renderer as a hint of how Firefox draws
// (radeonsi or llvmpipe); Firefox otherwise reports a generic family name
// ("Radeon R9 200 Series, or similar") that says neither.
user_pref("webgl.sanitize-unmasked-renderer", false);
// Firefox counts every start that it doesn't see finish as a crash, and
// after three it restarts itself in safe mode (no GPU acceleration, no
// add-ons) until a start succeeds. A sign loses power or is restarted
// mid-start often enough to trip that, so turn the count off.
user_pref("toolkit.startup.max_resumed_crashes", -1);
// One WebRender tile the size of the screen: see screen_size above.
user_pref("gfx.webrender.picture-tile-width", $tile_w);
user_pref("gfx.webrender.picture-tile-height", $tile_h);
PREFS
# The sign is powered off or rebooted without Firefox exiting cleanly, so
# the profile always holds a "previous session". Drop it, or Firefox shows
# an "Open previous tabs?" bar across the top of the screen.
rm -rf "$HOME/firefox/sessionstore.jsonlz4" "$HOME/firefox/sessionstore-backups"
# Where Firefox writes a Gecko profile when signage-profile sends it SIGUSR2
# (after starting the profiler with SIGUSR1). Costs nothing until then: the
# profiler only runs between the two signals.
export MOZ_UPLOAD_DIR=/var/lib/signage/profiles/.dump
# Not exec: cage ends, and systemd starts the kiosk again, only when every
# process holding the pipe cage gave this script has gone. With Firefox
# exec'd over this script, the status loop above was still holding it after
# Firefox died, so cage never noticed: the screen stayed black, with a
# zombie Firefox, until someone restarted the service.
firefox-esr --kiosk --no-remote --profile "$HOME/firefox" "$URL"
rc=$?
echo "kiosk: Firefox exited ($rc)" >&2
pkill -P "$status_pid" 2>/dev/null
kill "$status_pid" 2>/dev/null
exit "$rc"
