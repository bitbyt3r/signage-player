#!/bin/bash
# GPU and rendering check, for the dashboard's web terminal (run as root):
#   signage-gfx
# Prints the GPU, whether Firefox renders on it (radeonsi) or in software
# (llvmpipe), the player's renderer and frame stats, GPU load and
# temperatures, a 5 s radeontop sample, the memory modules and a short
# memory bandwidth test. See docs/player.md ("Profiling").
set -uo pipefail

h() { printf '\n== %s\n' "$1"; }

h "GPU"
if command -v lspci >/dev/null; then
    lspci -nn | grep -Ei 'vga|3d|display' || echo "no display controller in lspci"
else
    found=""
    for d in /sys/class/drm/card[0-9]; do
        [[ -r $d/device/vendor ]] || continue
        v=$(<"$d/device/vendor"); p=$(<"$d/device/device")
        case $v in 0x1002) name=AMD ;; 0x8086) name=Intel ;; 0x10de) name=NVIDIA ;; 0x1af4) name="virtio" ;; *) name="vendor $v" ;; esac
        drv=$(basename "$(readlink -f "$d/device/driver" 2>/dev/null)" 2>/dev/null)
        echo "${d##*/}: $name device $p, driver ${drv:-none}"
        found=1
    done
    [[ -n $found ]] || echo "no GPU in /sys/class/drm"
fi

h "Firefox rendering"
pids=$(pgrep -x firefox-esr; pgrep -f 'firefox-esr.*-contentproc' ; pgrep -x 'Web Content'; pgrep -x 'GPU Process')
pids=$(echo "$pids" | sort -un | tr '\n' ' ')
if [[ -z ${pids// } ]]; then
    echo "WebRender/GL: unknown (Firefox isn't running)"
else
    libs=$(for p in $pids; do cat "/proc/$p/maps" 2>/dev/null; done | grep -oE '[^/ ]*(_dri\.so|libgallium[^/ ]*\.so[^ ]*)' | sort -u)
    if grep -q radeonsi <<<"$libs"; then
        echo "WebRender/GL: HARDWARE (radeonsi)"
    elif grep -qE 'iris|crocus|i965|nouveau|virtio_gpu' <<<"$libs"; then
        echo "WebRender/GL: HARDWARE ($(grep -oE 'iris|crocus|i965|nouveau|virtio_gpu' <<<"$libs" | head -1))"
    elif grep -qE 'swrast|llvmpipe|kms_swrast' <<<"$libs"; then
        echo "WebRender/GL: SOFTWARE (llvmpipe/swrast)"
    elif [[ -n $libs ]]; then
        echo "WebRender/GL: unknown"
    else
        echo "WebRender/GL: SOFTWARE (no Mesa driver mapped: Firefox's own software WebRender)"
    fi
    [[ -n $libs ]] && echo "Mapped: $(tr '\n' ' ' <<<"$libs")"
fi

h "Player (/run/signage/perf.json)"
if [[ -r /run/signage/perf.json ]]; then
    jq -r --argjson now "$(date +%s)" '
        "renderer: \(.renderer // "?")",
        "layout:   \(.layout // "?")",
        "window:   \(.frames // 0) frames in \(.window // 0) s, \(.fps // 0) fps, \(($now - (.t // 0)) | floor) s ago",
        "frame ms: p50 \(.frame_ms.p50 // "?")  p95 \(.frame_ms.p95 // "?")  p99 \(.frame_ms.p99 // "?")  max \(.frame_ms.max // "?")",
        "long frames (>50 ms): \(.long_frames // 0)",
        (.active // [] | .[] | "showing:  layer \(.layer) \(.layer_name // ""): \(.package) \(.version // "") \(.label // "")")
    ' /run/signage/perf.json
else
    echo "no perf.json (is the player running?)"
fi

h "GPU load and temperatures"
for f in /sys/class/drm/card[0-9]/device/gpu_busy_percent; do
    [[ -r $f ]] && echo "${f%/device/*}: busy $(<"$f")%" | sed 's|/sys/class/drm/||'
done
for hw in /sys/class/hwmon/hwmon*; do
    [[ -r $hw/name ]] || continue
    n=$(<"$hw/name")
    case $n in amdgpu|k10temp|coretemp|acpitz|nvme) ;; *) continue ;; esac
    for t in "$hw"/temp*_input; do
        [[ -r $t ]] || continue
        l=${t%_input}_label
        printf '%s %s: %s °C\n' "$n" "$( [[ -r $l ]] && cat "$l" || basename "${t%_input}")" "$(awk '{printf "%.1f", $1/1000}' "$t")"
    done
done

h "radeontop (5 s)"
if command -v radeontop >/dev/null; then
    timeout 10 radeontop -d - -l 5 2>&1 || echo "radeontop failed (not an AMD GPU?)"
else
    echo "radeontop isn't installed"
fi

h "Memory"
# The integrated GPU uses system RAM, so its bandwidth is the RAM's: one
# module (single channel) gives it half of what two give.
if command -v dmidecode >/dev/null; then
    dmidecode -t 17 | awk -F': ' '
        /^Memory Device/ { n++ }
        /^\tLocator:/ { loc[n] = $2 }
        /^\tSize:/ { size[n] = $2 }
        /^\tSpeed:/ { sp[n] = $2 }
        /^\tConfigured Memory Speed:/ { cs[n] = $2 }
        /^\tPart Number:/ { pn[n] = $2 }
        END {
            for (i = 1; i <= n; i++) {
                if (size[i] ~ /No Module/) { printf "%-12s empty\n", loc[i]; continue }
                used++
                printf "%-12s %s, rated %s, running at %s  %s\n", loc[i], size[i], sp[i], cs[i], pn[i]
            }
            printf "%d of %d slots used: %s\n", used, n, (used >= 2 ? "dual channel" : "SINGLE CHANNEL (GPU memory bandwidth halved)")
        }'
else
    echo "dmidecode isn't installed"
fi
for d in /sys/class/drm/card[0-9]/device; do
    [[ -r $d/mem_info_vram_total ]] || continue
    echo "${d%/device}: GPU memory carve-out $(( $(<"$d/mem_info_vram_total") >> 20 )) MiB, used $(( $(<"$d/mem_info_vram_used") >> 20 )) MiB" | sed 's|/sys/class/drm/||'
    [[ -r $d/pp_dpm_mclk ]] && echo "memory clock levels (* = now):" && sed 's/^/  /' "$d/pp_dpm_mclk"
done

h "Memory bandwidth (mbw, 256 MiB copies)"
if command -v mbw >/dev/null; then
    timeout 60 mbw -q -n 5 256 2>&1 | grep AVG || echo "mbw failed"
    echo "(MEMCPY: dual-channel DDR4-2400 is roughly twice what single channel gets)"
else
    echo "mbw isn't installed"
fi
