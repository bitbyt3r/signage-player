#!/bin/bash
# Prints the whole-disk device the firmware booted us from.
set -euo pipefail
var=/sys/firmware/efi/efivars/LoaderDevicePartUUID-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
# efivarfs files can't be seeked, so read through cat (skip the 4 attribute
# bytes, then UTF-16 to ASCII).
uuid=$(cat "$var" | tail -c +5 | tr -d '\0' | tr 'A-F' 'a-f')
part=$(readlink -f "/dev/disk/by-partuuid/$uuid")
echo "/dev/$(lsblk -no PKNAME "$part" | head -n1)"
