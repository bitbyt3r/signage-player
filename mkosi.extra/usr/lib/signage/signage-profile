#!/bin/bash
# Record a Firefox (Gecko profiler) profile of the running player, for the
# dashboard's web terminal and its "GPU profile" button (run as root):
#   signage-profile [SECONDS]     default 30
# Starts the profiler in the running Firefox (SIGUSR1), lets it run for
# SECONDS, has it write every process's profile (SIGUSR2) and prints where
# the profile is. Firefox isn't restarted. Open the profile at
# https://profiler.firefox.com. See docs/player.md ("Profiling").
#
# Contract with the dashboard agent: exit 0 only when it worked, leaving
# exactly one new /var/lib/signage/profiles/profile-<host>-<UTC>.json.gz
# (the newest 5 are kept); otherwise non-zero with the reason on stderr.
#
# Firefox ESR 153 on these signals: SIGUSR1 starts the profiler with fixed
# settings (features js, stackwalk, cpu; all threads; 1 ms; no screenshots)
# and ignores MOZ_PROFILER_STARTUP_*. SIGUSR2 stops it, gathers the parent
# and every child process (the page runs in a content process) and writes
# one $MOZ_UPLOAD_DIR/profile_0_<pid>.json. The kiosk sets MOZ_UPLOAD_DIR.
set -uo pipefail

SECS=${1:-30}
[[ $SECS =~ ^[0-9]+$ && $SECS -ge 1 && $SECS -le 3600 ]] || { echo "usage: signage-profile [SECONDS 1-3600]" >&2; exit 2; }
# SIGNAGE_PROFILE_* override the user and output dir for tests (docs/player.md).
KUSER=${SIGNAGE_PROFILE_USER:-signage}
[[ $EUID -eq 0 || -n ${SIGNAGE_PROFILE_USER:-} ]] || { echo "signage-profile: run as root" >&2; exit 1; }

DIR=${SIGNAGE_PROFILE_DIR:-/var/lib/signage/profiles}
KEEP=5
GATHER_S=120  # gathering every process took ~9 s headless; a busy 4K sign is slower
HOST=$(tr -c 'A-Za-z0-9._-' '-' </proc/sys/kernel/hostname | sed 's/-*$//')
[[ -n $HOST ]] || HOST=signage
OUT="$DIR/profile-$HOST-$(date -u +%Y%m%dT%H%M%SZ).json.gz"

fail() { echo "signage-profile: $*" >&2; exit 1; }

firefox_main() {
    # The browser process: firefox-esr run by the kiosk, not a -contentproc child.
    local p
    for p in $(pgrep -u "$KUSER" -x firefox-esr); do
        tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null | grep -q -- '-contentproc' || { echo "$p"; return 0; }
    done
    return 1
}

pid=$(firefox_main) || fail "the player's Firefox isn't running; see journalctl -u signage-player"
DUMP=$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | sed -n 's/^MOZ_UPLOAD_DIR=//p')
[[ -n $DUMP ]] || fail "Firefox (pid $pid) has no MOZ_UPLOAD_DIR; it was started by an older kiosk, restart the player once (systemctl restart signage-player)"
# It's emptied below as root, so only ever the kiosk's own directory.
[[ $DUMP == "$DIR/.dump" ]] || fail "Firefox's MOZ_UPLOAD_DIR is $DUMP, not $DIR/.dump; restart the player (systemctl restart signage-player)"

install -d -m 0750 -o "$KUSER" -g "$KUSER" "$DIR"
rm -rf "$DUMP"
install -d -m 0750 -o "$KUSER" -g "$KUSER" "$DUMP"
running=""
# Never leave the profiler running: SIGUSR2 is the only way to stop it.
trap '[[ -n $running ]] && kill -USR2 "$pid" 2>/dev/null; rm -rf "$DUMP"' EXIT

echo "Profiling Firefox (pid $pid) for $SECS s…"
kill -USR1 "$pid" || fail "couldn't signal Firefox (pid $pid)"
running=1
sleep "$SECS"
kill -0 "$pid" 2>/dev/null || { running=""; fail "Firefox exited during the profile; see journalctl -u signage-player"; }

echo "Asking Firefox to write the profile (gathering every process)…"
kill -USR2 "$pid"
running=""
# Firefox writes the file once every process has answered; wait until it
# parses as complete JSON.
f=""
for _ in $(seq $((GATHER_S * 2))); do
    sleep 0.5
    f=$(ls -1t "$DUMP"/profile_*.json 2>/dev/null | head -1)
    [[ -n $f && -s $f ]] || continue
    python3 -c 'import json, sys; json.load(open(sys.argv[1]))' "$f" 2>/dev/null && break
    f=""
done
[[ -n $f ]] || fail "NO PROFILE WRITTEN: Firefox didn't write a complete profile within $GATHER_S s of SIGUSR2"
procs=$(python3 -c 'import json, sys
d = json.load(open(sys.argv[1]))
print(sum(1 for p in d.get("processes", []) if any(t.get("processType") == "tab" for t in p.get("threads", []))))' "$f" 2>/dev/null || echo 0)
[[ $procs -ge 1 ]] || echo "signage-profile: warning: the profile has no content (tab) process; the page's own work isn't in it" >&2

gzip -c "$f" >"$OUT.tmp" && mv -f "$OUT.tmp" "$OUT" || { rm -f "$OUT.tmp"; fail "couldn't write $OUT"; }
chmod 0640 "$OUT"
# Keep the newest few, never the one just written.
ls -1t "$DIR"/profile-*.json.gz 2>/dev/null | grep -vxF "$OUT" | tail -n +"$KEEP" | xargs -r rm -f

echo
echo "Profile: $OUT ($(du -h "$OUT" | cut -f1), $procs content process(es))"
echo "Download it from the dashboard (GPU profile), or copy it off the player,"
echo "then open https://profiler.firefox.com and choose \"Load a profile from"
echo "file\" (.json.gz loads as is)."
