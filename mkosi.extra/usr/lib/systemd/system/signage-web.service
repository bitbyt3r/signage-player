[Unit]
Description=Local web server for the signage player page and OGraf packages
# See /usr/lib/signage/signage-web for what it serves.
Before=signage-player.service

[Service]
ExecStart=/usr/lib/signage/signage-web
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6
Restart=on-failure

[Install]
WantedBy=multi-user.target
