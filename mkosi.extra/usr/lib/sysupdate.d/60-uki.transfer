[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=https://github.com/bitbyt3r/signage-player/releases/latest/download/
MatchPattern=signage_@v.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=signage_@v+@l-@d.efi \
             signage_@v+@l.efi \
             signage_@v.efi
Mode=0444
TriesLeft=3
TriesDone=0
InstancesMax=2
