[Transfer]
ProtectVersion=%A
# SHA256SUMS must carry a valid SHA256SUMS.gpg from the release key
# (/usr/lib/systemd/import-pubring.gpg). CI signs it.
Verify=yes

[Source]
Type=url-file
Path=https://github.com/bitbyt3r/signage-player/releases/latest/download/
MatchPattern=signage_@v.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=signage_@v+@l-@d.efi \
             signage_@v+@l.efi \
             signage_@v.efi
Mode=0444
TriesLeft=3
TriesDone=0
InstancesMax=2
