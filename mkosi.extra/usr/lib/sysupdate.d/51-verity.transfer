[Transfer]
ProtectVersion=%A
# SHA256SUMS must carry a valid SHA256SUMS.gpg from the release key
# (/usr/lib/systemd/import-pubring.gpg). CI signs it.
Verify=yes

[Source]
Type=url-file
Path=https://github.com/bitbyt3r/signage-player/releases/latest/download/
MatchPattern=signage_@v.usr-x86-64-verity.@u.raw.zst

[Target]
Type=partition
Path=auto
MatchPattern=signage_verity_@v
MatchPartitionType=usr-verity
PartitionFlags=0
ReadOnly=1
